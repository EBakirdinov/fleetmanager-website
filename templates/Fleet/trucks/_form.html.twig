{# Shared truck form fields. Expects: formData (array) #}

{% if error %}
<div class="fleet-alert alert-danger" style="margin-bottom:20px;">{{ error }}</div>
{% endif %}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">

    <div class="fleet-form-group">
        <label class="fleet-label" for="truckNumber">Truck Number</label>
        <input class="fleet-control"
               type="text"
               id="truckNumber"
               name="truckNumber"
               value="{{ formData.truckNumber ?? '' }}"
               placeholder="e.g. TRK-104"
               required>
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="status">Status</label>
        <select class="fleet-select" id="status" name="status" required>
            <option value="1" {{ (formData.status ?? '1') == '1' ? 'selected' : '' }}>Active</option>
            <option value="0" {{ (formData.status ?? '1') == '0' ? 'selected' : '' }}>Inactive</option>
        </select>
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="make">Make</label>
        <input class="fleet-control"
               type="text"
               id="make"
               name="make"
               value="{{ formData.make ?? '' }}"
               placeholder="e.g. Freightliner">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="model">Model</label>
        <input class="fleet-control"
               type="text"
               id="model"
               name="model"
               value="{{ formData.model ?? '' }}"
               placeholder="e.g. Cascadia">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="year">Year</label>
        <input class="fleet-control"
               type="number"
               id="year"
               name="year"
               min="1900"
               max="2100"
               value="{{ formData.year ?? '' }}"
               placeholder="e.g. 2022">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="plateNumber">Plate Number</label>
        <input class="fleet-control"
               type="text"
               id="plateNumber"
               name="plateNumber"
               value="{{ formData.plateNumber ?? '' }}"
               placeholder="e.g. ABC-1234">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="lastInspectionDate">Last Inspection Date</label>
        <input class="fleet-control"
               type="date"
               id="lastInspectionDate"
               name="lastInspectionDate"
               value="{{ formData.lastInspectionDate ?? '' }}">
    </div>

</div>
