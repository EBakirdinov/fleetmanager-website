{% extends 'Fleet/base.html.twig' %}

{% block title %}Dashboard — FleetManager{% endblock %}

{% block breadcrumb %}
    <span class="bc-sep">›</span>
    <span class="bc-current">Dashboard</span>
{% endblock %}

{% block content %}
    <div class="page-head">
        <h1 class="page-heading">
            Dashboard
            <span class="live-pill">Live</span>
        </h1>
        <p class="page-sub">Overview of your fleet operations — updated in real-time.</p>
    </div>

    {# Stats #}
