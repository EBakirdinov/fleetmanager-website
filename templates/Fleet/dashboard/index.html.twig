                        <div>
                            <div class="alert-item-title">{{ a.title }}</div>
                            <div class="alert-item-sub">{{ a.sub }}</div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="fleet-card">
