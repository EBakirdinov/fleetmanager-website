                    <a href="{{ path('fleet_notifications') }}" class="view-all-link">View All</a>
                </div>
                <div style="padding:4px 0;">
                    {% set alerts = [
                        {color:'#fee2e2',fill:'#dc2626',title:'T-108 — Geofence Exit',sub:'Baton Rouge, LA · 10m ago'},
                        {color:'#fef3c7',fill:'#d97706',title:'T-106 — Engine Idle',sub:'Memphis, TN · 25m ago'},
