<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In — FleetManager</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {{ encore_entry_link_tags('css/fleet-login') }}
    <script>(function(){if(localStorage.getItem('fleet_theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}());</script>
</head>
<body>

<div class="fleet-login-wrap">

    {# ===== Left branding panel ===== #}
    <div class="login-brand-panel">

        <a href="{{ path('fleet_login') }}" class="login-brand-logo">
            <div class="login-logo-icon">
                <svg viewBox="0 0 24 24" fill="white">
                    <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </svg>
            </div>
            <div class="login-logo-text">
                <span class="llogo-main">FleetManager</span>
                <span class="llogo-sub">Dispatch Pro</span>
            </div>
        </a>

        <h1 class="login-headline">
            Manage your fleet<br>
            <span>smarter &amp; faster</span>
        </h1>

        <p class="login-tagline">
            Complete fleet management and dispatch platform.
            Track trucks in real-time, manage loads, drivers,
            and DOT compliance — all in one place.
        </p>

        <div class="login-features">
            <div class="login-feature-item"><span class="lf-dot"></span> Real-time GPS tracking for all trucks</div>
            <div class="login-feature-item"><span class="lf-dot"></span> Load management &amp; dispatch board</div>
            <div class="login-feature-item"><span class="lf-dot"></span> DOT compliance &amp; document management</div>
            <div class="login-feature-item"><span class="lf-dot"></span> Driver performance &amp; payroll tracking</div>
            <div class="login-feature-item"><span class="lf-dot"></span> IFTA fuel reports &amp; expense management</div>
        </div>

    </div>

    {# ===== Right form panel ===== #}
    <div class="login-form-panel" style="position:relative;">
        <button id="loginThemeToggle" class="login-theme-btn" title="Toggle dark mode" style="position:absolute;top:18px;right:20px;background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;display:flex;align-items:center;justify-content:center;transition:background .15s;">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>

        <div class="lform-header">
            <h2 class="lform-title">Welcome back</h2>
            <p class="lform-sub">Sign in to your FleetManager account</p>
        </div>

        {# Error from session #}
        {% if app.session.get('fleet_login_error') %}
            <div class="lform-alert alert-danger" data-auto-dismiss>
                {{ app.session.get('fleet_login_error') }}
                {% do app.session.remove('fleet_login_error') %}
            </div>
        {% endif %}

        {# Flash errors (if using Symfony Security form_login later) #}
        {% for msg in app.flashes('fleet_error') %}
            <div class="lform-alert alert-danger" data-auto-dismiss>{{ msg }}</div>
        {% endfor %}

        <form method="post" action="{{ path('fleet_login') }}" id="fleetLoginForm" novalidate>

            <div class="lform-group">
                <label class="lform-label" for="fleet_email">Email address</label>
                <input
                    type="email"
                    id="fleet_email"
                    name="email"
                    class="lform-control"
                    value="{{ app.session.get('fleet_last_email') ?? '' }}"
                    placeholder="admin@fleetmanager.com"
                    autocomplete="email"
                    autofocus
                    required
                >
            </div>

            <div class="lform-group">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;">
                    <label class="lform-label" for="fleet_password" style="margin-bottom:0;">Password</label>
                    <a href="#" class="lform-forgot">Forgot password?</a>
                </div>
                <div class="pw-wrapper">
                    <input
                        type="password"
                        id="fleet_password"
                        name="password"
                        class="lform-control"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required
                        style="padding-right: 40px;"
                    >
                    <button type="button" class="pw-toggle" tabindex="-1">
                        <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="lform-row-space">
                <label class="lform-remember">
                    <input type="checkbox" name="remember_me">
                    Remember me for 7 days
                </label>
            </div>

            <button type="submit" class="lform-submit">
                Sign In
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </button>

        </form>

        <div class="lform-footer">
            <p>&copy; {{ "now"|date("Y") }} FleetManager. All rights reserved.</p>
        </div>

    </div>
</div>

<script>
(function () {
    // Password toggle
    document.querySelectorAll('.pw-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var inp = this.closest('.pw-wrapper').querySelector('input');
            var isPw = inp.type === 'password';
            inp.type = isPw ? 'text' : 'password';
            this.querySelector('.eye-on').style.display = isPw ? 'none'  : '';
            this.querySelector('.eye-off').style.display = isPw ? '' : 'none';
        });
    });

    // Auto-dismiss alerts
    document.querySelectorAll('[data-auto-dismiss]').forEach(function (el) {
        setTimeout(function () {
            el.style.transition = 'opacity .4s';
            el.style.opacity = '0';
            setTimeout(function () { el.remove(); }, 420);
        }, 4500);
    });

    // Theme toggle
    function applyTheme(dark) {
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        var btn = document.getElementById('loginThemeToggle');
        if (!btn) return;
        btn.querySelector('.icon-sun').style.display  = dark ? 'none' : '';
        btn.querySelector('.icon-moon').style.display = dark ? '' : 'none';
    }

    applyTheme(localStorage.getItem('fleet_theme') === 'dark');

    document.getElementById('loginThemeToggle').addEventListener('click', function () {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        localStorage.setItem('fleet_theme', isDark ? 'light' : 'dark');
        applyTheme(!isDark);
    });
}());
</script>
</body>
</html>
