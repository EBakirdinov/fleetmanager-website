<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}FleetManager{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {{ encore_entry_link_tags('css/fleet') }}
    {% block stylesheets %}{% endblock %}

    <script>
        (function () {
            if (localStorage.getItem('fleet_theme') === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body>

<div class="fleet-sidebar-overlay" id="fleetOverlay"></div>

<div class="fleet-wrapper">
    {# ==================== SIDEBAR ==================== #}
    {% set route = app.request.attributes.get('_route') %}
    <aside class="fleet-sidebar" id="fleetSidebar">
        <a href="{{ path('fleet_dashboard') }}" class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </svg>
            </div>
            <div class="sidebar-logo-text">
                <span class="brand-main">FleetManager</span>
            </div>
        </a>

        {# Navigation #}
        <nav class="sidebar-nav">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="{{ path('fleet_dashboard') }}" class="nav-link {{ route == 'fleet_dashboard' or route == 'fleet_dashboard_slash' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
                        <span class="nav-link-text">Dashboard</span>
                    </a>
                </li>

                {# <li class="nav-item">
                    <a href="{{ path('fleet_loads') }}" class="nav-link {{ route == 'fleet_loads' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
                        <span class="nav-link-text">Loads</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_trucks') }}" class="nav-link {{ route starts with 'fleet_truck' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
                        <span class="nav-link-text">Trucks</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_trailers') }}" class="nav-link {{ route == 'fleet_trailers' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 5H3c-1.1 0-2 .89-2 2v9h2c0 1.65 1.34 3 3 3s3-1.35 3-3h5.5c0 1.65 1.34 3 3 3s3-1.35 3-3H23v-5l-6-6zM3 11V7h4v4H3zm3 6.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm7-6.5H9V7h4v4zm4.5 6.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM15 11V7h1l4 4h-5z"/></svg>
                        <span class="nav-link-text">Trailers</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_drivers') }}" class="nav-link {{ route == 'fleet_drivers' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        <span class="nav-link-text">Drivers</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_dispatch') }}" class="nav-link {{ route == 'fleet_dispatch' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                        <span class="nav-link-text">Dispatch</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_inspections') }}" class="nav-link {{ route == 'fleet_inspections' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        <span class="nav-link-text">Inspections</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_reports') }}" class="nav-link {{ route == 'fleet_reports' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                        <span class="nav-link-text">Reports</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_documents') }}" class="nav-link {{ route == 'fleet_documents' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                        <span class="nav-link-text">Documents</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_notifications') }}" class="nav-link {{ route == 'fleet_notifications' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
                        <span class="nav-link-text">Notifications</span>
                        <span class="nav-badge">3</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('fleet_settings') }}" class="nav-link {{ route == 'fleet_settings' ? 'active' : '' }}">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                        <span class="nav-link-text">Settings</span>
                    </a>
                </li> #}

                <li class="nav-item" style="margin-top:4px;">
                    <a href="{{ path('fleet_components') }}" class="nav-link {{ route == 'fleet_components' ? 'active' : '' }}" style="opacity:.6;font-size:12px;">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 13h2v-2H6v2zm0 4h2v-2H6v2zm0-8h2V7H6v2zm4 4h8v-2h-8v2zm0 4h8v-2h-8v2zm0-8h8V7h-8v2zM20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H4V5h16v14z"/></svg>
                        <span class="nav-link-text">UI Components</span>
                    </a>
                </li>
            </ul>
        </nav>

        {# Fleet Overview section #}
        {# <div class="fleet-overview-section">
            <div class="fleet-overview-label">Fleet Overview</div>
            <div class="fleet-overview-item">
                <div class="fo-icon">+</div>
                <span class="fo-text">10 Trucks</span>
            </div>
            <div class="fleet-overview-item">
                <div class="fo-icon" style="background:#0d9488;">+</div>
                <span class="fo-text">18 Trailers</span>
            </div>
            <div class="fleet-overview-item">
                <div class="fo-icon" style="background:#7c3aed;">+</div>
                <span class="fo-text">14 Drivers</span>
            </div>
        </div> #}

        {# Log Out #}
        <a href="{{ path('fleet_logout') }}" class="sidebar-logout">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
            <span>Log Out</span>
        </a>
    </aside>

    {# ==================== MAIN ==================== #}
    <div class="fleet-main">
        <header class="fleet-header">
            <button class="header-toggle-btn" id="fleetSidebarToggle" title="Toggle sidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <nav class="header-breadcrumb">
                <a href="{{ path('fleet_dashboard') }}">Home</a>

                {% block breadcrumb %}{% endblock %}
            </nav>

            <div class="header-spacer"></div>

            <div class="header-search-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" placeholder="{% block search_placeholder %}Search...{% endblock %}">
            </div>

            <div class="header-icon-btns">
                <button class="header-icon-btn" id="themeToggle" title="Toggle dark mode" style="cursor:pointer;border:none;background:none;">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>

                <a href="{{ path('fleet_notifications') }}" class="header-icon-btn" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                    </svg>
                    <span class="notif-dot">1</span>
                </a>

                <div class="fleet-dropdown">
                    <button class="header-user-btn" id="userMenuBtn" data-dropdown-toggle="#userMenu">
                        <div class="header-avatar-sm">
                            {{ app.session.get('first_name') ? app.session.get('first_name')|slice(0,2)|upper : 'US' }}
                        </div>

                        <span class="hu-name d-none d-inline-block" style="font-size:13px;font-weight:600;">
                            {{ app.session.get('first_name') ?? 'User' }}
                        </span>
                        <svg class="hu-chevron" style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="fleet-dropdown-menu" id="userMenu">
                        <div class="fleet-dropdown-header">{{ app.session.get('user_email') ?? '' }}</div>
                        <a href="{{ path('fleet_settings') }}" class="fleet-dropdown-item">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                            Settings
                        </a>
                        <div class="fleet-dropdown-divider"></div>
                        <a href="{{ path('fleet_logout') }}" class="fleet-dropdown-item danger">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                            Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            <div class="fleet-flash">
                {% for msg in messages %}
                    <div class="fleet-alert fleet-alert-{{ label == 'error' ? 'danger' : label }}" data-auto-dismiss>{{ msg }}</div>
                {% endfor %}
            </div>
        {% endfor %}

        {# Page content #}
        <main class="fleet-page">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

{{ encore_entry_script_tags('js/fleet') }}

{% block javascripts %}{% endblock %}
</body>
</html>
