{% extends 'Fleet/base.html.twig' %}
{% block title %}Add Load — FleetManager{% endblock %}
{% block breadcrumb %}
    <span class="bc-sep">›</span>
    <a href="{{ path('fleet_loads') }}">Loads</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Add Load</span>
{% endblock %}

{% block content %}
<div class="page-head">
    <h1 class="page-heading">Add Load</h1>
    <p class="page-sub">Create a new freight load and optionally assign a driver.</p>
</div>

<div class="fleet-card" style="max-width:820px;">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Load Information</h3>
    </div>
    <div class="fleet-card-body" style="padding:24px;">
        <form method="POST" action="{{ path('fleet_load_new') }}">
            {% include 'Fleet/loads/_form.html.twig' with {formData: formData, error: error, drivers: drivers} %}

            <div class="form-footer">
                <button type="submit" class="fleet-btn btn-primary-fleet">Create Load</button>
                <a href="{{ path('fleet_loads') }}" class="fleet-btn btn-outline-fleet">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
