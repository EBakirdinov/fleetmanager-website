{# Shared load form fields. Expects: formData (array), drivers (array) #}

{% if error %}
<div class="fleet-alert alert-danger" style="margin-bottom:20px;">{{ error }}</div>
{% endif %}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">

    <div class="fleet-form-group">
        <label class="fleet-label" for="referenceNumber">Reference Number</label>
        <input class="fleet-control"
               type="text"
               id="referenceNumber"
               name="referenceNumber"
               value="{{ formData.referenceNumber ?? '' }}"
               placeholder="e.g. LD-10293"
               required>
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="status">Status</label>
        <select class="fleet-select" id="status" name="status" required>
            {% set st = formData.status ?? 'pending' %}
            <option value="pending"    {{ st == 'pending'    ? 'selected' : '' }}>Pending</option>
            <option value="assigned"   {{ st == 'assigned'   ? 'selected' : '' }}>Assigned</option>
            <option value="in_transit" {{ st == 'in_transit' ? 'selected' : '' }}>In Transit</option>
            <option value="delivered"  {{ st == 'delivered'  ? 'selected' : '' }}>Delivered</option>
            <option value="cancelled"  {{ st == 'cancelled'  ? 'selected' : '' }}>Cancelled</option>
        </select>
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="origin">Origin</label>
        <input class="fleet-control"
               type="text"
               id="origin"
               name="origin"
               value="{{ formData.origin ?? '' }}"
               placeholder="e.g. Chicago, IL">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="destination">Destination</label>
        <input class="fleet-control"
               type="text"
               id="destination"
               name="destination"
               value="{{ formData.destination ?? '' }}"
               placeholder="e.g. Dallas, TX">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="pickupDate">Pickup Date</label>
        <input class="fleet-control"
               type="date"
               id="pickupDate"
               name="pickupDate"
               value="{{ formData.pickupDate ?? '' }}">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="deliveryDate">Delivery Date</label>
        <input class="fleet-control"
               type="date"
               id="deliveryDate"
               name="deliveryDate"
               value="{{ formData.deliveryDate ?? '' }}">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="rate">Rate ($)</label>
        <input class="fleet-control"
               type="number"
               step="0.01"
               min="0"
               id="rate"
               name="rate"
               value="{{ formData.rate ?? '' }}"
               placeholder="e.g. 2500.00">
    </div>

    <div class="fleet-form-group">
        <label class="fleet-label" for="driver">Driver</label>
        <select class="fleet-select" id="driver" name="driver">
            <option value="">Unassigned</option>
            {% for d in drivers %}
                <option value="{{ d.id }}" {{ (formData.driver ?? '') == d.id ? 'selected' : '' }}>
                    {{ ((d.first_name ?? '') ~ ' ' ~ (d.last_name ?? ''))|trim ?: ('#' ~ d.id) }}
                </option>
            {% endfor %}
        </select>
    </div>

</div>
