{% extends 'Fleet/base.html.twig' %}
{% block title %}Loads — FleetManager{% endblock %}
{% block breadcrumb %}<span class="bc-sep">›</span><span class="bc-current">Loads</span>{% endblock %}

{% block content %}
<div class="page-head d-flex items-center justify-between flex-wrap gap-4">
    <div>
        <h1 class="page-heading">Loads</h1>
        <p class="page-sub">Manage freight loads, dispatch orders, and deliveries.</p>
    </div>
    <a href="{{ path('fleet_load_new') }}" class="fleet-btn btn-primary-fleet">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        Add Load
    </a>
</div>

{# Stats #}
{% set total     = loads|length %}
{% set pending   = loads|filter(l => l.status == 'pending')|length %}
{% set transit   = loads|filter(l => l.status == 'in_transit')|length %}
{% set delivered = loads|filter(l => l.status == 'delivered')|length %}

<div class="fleet-stats-row cols-4" style="margin-bottom:18px;">
    <a href="{{ path('fleet_loads') }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Total Loads</div>
        <div class="fleet-stat-value">{{ total }}</div>
    </a>
    <a href="{{ path('fleet_loads', {status:'pending'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Pending</div>
        <div class="fleet-stat-value text-warning">{{ pending }}</div>
    </a>
    <a href="{{ path('fleet_loads', {status:'in_transit'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">In Transit</div>
        <div class="fleet-stat-value text-info">{{ transit }}</div>
    </a>
    <a href="{{ path('fleet_loads', {status:'delivered'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Delivered</div>
        <div class="fleet-stat-value text-success">{{ delivered }}</div>
    </a>
</div>

{# Active filter chip #}
{% if statusFilter %}
<div class="d-flex items-center gap-3" style="margin-bottom:14px;">
    <span class="text-sm text-sub">Filtered by status:</span>
    <span class="fleet-badge badge-gray">{{ statusFilter|replace({'_':' '})|title }}</span>
    <a href="{{ path('fleet_loads') }}" class="text-sm text-sub" style="text-decoration:none;">✕ Clear</a>
</div>
{% endif %}

<div class="fleet-card">
    {% if loads|length == 0 %}
        <div class="fleet-empty">
            <div class="fleet-empty-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
            </div>
            <div class="fleet-empty-title">No loads found</div>
            <div class="fleet-empty-text">
                {% if statusFilter %}No loads with that status.{% else %}Add your first load to get started.{% endif %}
            </div>
            {% if statusFilter %}
                <a href="{{ path('fleet_loads') }}" class="fleet-btn btn-outline-fleet">Clear filter</a>
            {% else %}
                <a href="{{ path('fleet_load_new') }}" class="fleet-btn btn-primary-fleet">Add Load</a>
            {% endif %}
        </div>
    {% else %}
        <div class="fleet-table-wrap">
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Route</th>
                        <th>Pickup</th>
                        <th>Delivery</th>
                        <th>Driver</th>
                        <th>Rate</th>
                        <th>Status</th>
                        <th style="width:90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for load in loads %}
                    <tr>
                        <td>
                            <a href="{{ path('fleet_load_edit', {id: load.id}) }}" class="fleet-link fw-600">
                                {{ load.reference_number ?? ('#' ~ load.id) }}
                            </a>
                        </td>
                        <td>
                            {% if (load.origin ?? false) or (load.destination ?? false) %}
                                {{ load.origin ?? '—' }} <span class="text-muted">→</span> {{ load.destination ?? '—' }}
                            {% else %}—{% endif %}
                        </td>
                        <td>{% if load.pickup_date ?? false %}{{ load.pickup_date|date('M d, Y') }}{% else %}—{% endif %}</td>
                        <td>{% if load.delivery_date ?? false %}{{ load.delivery_date|date('M d, Y') }}{% else %}—{% endif %}</td>
                        <td>
                            {% if load.driver ?? false %}
                                {{ ((load.driver.first_name ?? '') ~ ' ' ~ (load.driver.last_name ?? ''))|trim ?: ('#' ~ (load.driver.id ?? '')) }}
                            {% else %}
                                <span class="text-muted">Unassigned</span>
                            {% endif %}
                        </td>
                        <td>{% if load.rate ?? false %}${{ load.rate|number_format(2) }}{% else %}—{% endif %}</td>
                        <td>
                            {% if load.status == 'pending' %}
                                <span class="fleet-badge badge-warning">Pending</span>
                            {% elseif load.status == 'assigned' %}
                                <span class="fleet-badge badge-info">Assigned</span>
                            {% elseif load.status == 'in_transit' %}
                                <span class="fleet-badge badge-orange">In Transit</span>
                            {% elseif load.status == 'delivered' %}
                                <span class="fleet-badge badge-success">Delivered</span>
                            {% elseif load.status == 'cancelled' %}
                                <span class="fleet-badge badge-danger">Cancelled</span>
                            {% else %}
                                <span class="fleet-badge badge-gray">{{ load.status ?? '—' }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-1 items-center">
                                <a href="{{ path('fleet_load_edit', {id: load.id}) }}"
                                   class="fleet-btn btn-ghost-fleet btn-xs" title="Edit">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </a>
                                <button class="fleet-btn btn-ghost-danger btn-xs js-delete-load"
                                        data-id="{{ load.id }}"
                                        data-name="{{ load.reference_number ?? ('#' ~ load.id) }}"
                                        title="Delete">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Delete confirmation modal #}
<div class="fleet-modal-backdrop" id="deleteModal">
    <div class="fleet-modal modal-sm">
        <div class="fleet-modal-header">
            <h3 class="fleet-modal-title">Delete Load</h3>
            <button class="fleet-modal-close" id="deleteModalClose" type="button">&times;</button>
        </div>
        <div class="fleet-modal-body">
            <p class="m-0">Are you sure you want to delete <strong id="deleteLoadName"></strong>? This cannot be undone.</p>
        </div>
        <div class="fleet-modal-footer">
            <button class="fleet-btn btn-outline-fleet" id="deleteModalCancel" type="button">Cancel</button>
            <form id="deleteForm" method="POST" style="margin:0;">
                <button type="submit" class="fleet-btn btn-danger-fleet">Delete</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var modal     = document.getElementById('deleteModal');
    var nameEl    = document.getElementById('deleteLoadName');
    var form      = document.getElementById('deleteForm');
    var btnClose  = document.getElementById('deleteModalClose');
    var btnCancel = document.getElementById('deleteModalCancel');

    document.querySelectorAll('.js-delete-load').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id   = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name') || 'this load';
            nameEl.textContent = name;
            form.setAttribute('action', '/loads/' + id + '/delete');
            modal.classList.add('show');
        });
    });

    function closeModal() { modal.classList.remove('show'); }
    btnClose.addEventListener('click', closeModal);
    btnCancel.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
}());
</script>
{% endblock %}
