{% extends 'Fleet/base.html.twig' %}
{% block title %}UI Components — Fleet Manager{% endblock %}
{% block search_placeholder %}Search components...{% endblock %}
{% block breadcrumb %}<span class="bc-sep">›</span><span class="bc-current">Components</span>{% endblock %}

{% block content %}
<div class="page-head">
    <h1 class="page-heading">UI Components</h1>
    <p class="page-sub">Design system reference — all reusable components in one place.</p>
</div>

{# ================================================================
   BUTTONS
   ================================================================ #}
<div class="fleet-section-bar mb-5">
    <h2 class="fleet-section-title">Buttons</h2>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Variants</h3>
    </div>
    <div class="fleet-card-body d-flex flex-wrap gap-3">
        <button class="fleet-btn btn-primary-fleet">Primary</button>
        <button class="fleet-btn btn-outline-fleet">Outline</button>
        <button class="fleet-btn btn-ghost-fleet">Ghost</button>
        <button class="fleet-btn btn-success-fleet">Success</button>
        <button class="fleet-btn btn-success-outline">Success Outline</button>
        <button class="fleet-btn btn-danger-fleet">Danger</button>
        <button class="fleet-btn btn-danger-outline">Danger Outline</button>
        <button class="fleet-btn btn-warning-fleet">Warning</button>
        <button class="fleet-btn btn-warning-outline">Warning Outline</button>
        <button class="fleet-btn btn-info-fleet">Info</button>
        <button class="fleet-btn btn-dark-fleet">Dark</button>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Sizes</h3>
    </div>
    <div class="fleet-card-body d-flex flex-wrap items-center gap-3">
        <button class="fleet-btn btn-primary-fleet btn-xs">XSmall</button>
        <button class="fleet-btn btn-primary-fleet btn-sm">Small</button>
        <button class="fleet-btn btn-primary-fleet">Default</button>
        <button class="fleet-btn btn-primary-fleet btn-lg">Large</button>
        <button class="fleet-btn btn-primary-fleet btn-xl">XLarge</button>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">With Icons · Group · States</h3>
    </div>
    <div class="fleet-card-body d-flex flex-wrap gap-3">
        <button class="fleet-btn btn-primary-fleet">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            Add Item
        </button>
        <button class="fleet-btn btn-outline-fleet">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg>
            Export
        </button>
        <button class="fleet-btn btn-danger-fleet">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
            Delete
        </button>
        <div class="fleet-btn-group">
            <button class="fleet-btn btn-outline-fleet">Day</button>
            <button class="fleet-btn btn-outline-fleet btn-primary-fleet">Week</button>
            <button class="fleet-btn btn-outline-fleet">Month</button>
        </div>
        <button class="fleet-btn btn-primary-fleet loading">Saving...</button>
        <button class="fleet-btn btn-outline-fleet" disabled>Disabled</button>
    </div>
</div>

{# ================================================================
   BADGES & CHIPS
   ================================================================ #}
<div class="fleet-section-bar mb-5">
    <h2 class="fleet-section-title">Badges &amp; Chips</h2>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Status Badges</h3>
    </div>
    <div class="fleet-card-body d-flex flex-wrap gap-3">
        <span class="fleet-badge badge-success">Active</span>
        <span class="fleet-badge badge-warning">Pending</span>
        <span class="fleet-badge badge-danger">Cancelled</span>
        <span class="fleet-badge badge-info">In Transit</span>
        <span class="fleet-badge badge-gray">Inactive</span>
        <span class="fleet-badge badge-orange">On Hold</span>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Status Pills (table use)</h3>
    </div>
    <div class="fleet-card-body d-flex flex-wrap gap-3">
        <span class="status-pill s-booked">Booked</span>
        <span class="status-pill s-dispatched">Dispatched</span>
        <span class="status-pill s-intransit">In Transit</span>
        <span class="status-pill s-delivered">Delivered</span>
        <span class="status-pill s-cancelled">Cancelled</span>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Chips (removable tags)</h3>
    </div>
    <div class="fleet-card-body">
        <div class="fleet-chips">
            <span class="fleet-chip">
                New York
                <button class="chip-remove" aria-label="Remove">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
            </span>
            <span class="fleet-chip chip-primary">
                High Priority
                <button class="chip-remove"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
            </span>
            <span class="fleet-chip chip-success">Delivered</span>
            <span class="fleet-chip chip-danger">Overdue</span>
            <span class="fleet-chip chip-warning">
                Review Needed
                <button class="chip-remove"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
            </span>
        </div>
    </div>
</div>

{# ================================================================
   ALERTS
   ================================================================ #}
<div class="fleet-section-bar mb-5">
    <h2 class="fleet-section-title">Alerts</h2>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Alert variants</h3>
    </div>
    <div class="fleet-card-body d-flex flex-col gap-4">
        <div class="fleet-alert alert-info">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
            <div class="alert-body">
                <div class="alert-title">Heads up</div>
                <div class="alert-text">This is an informational message for the user.</div>
            </div>
            <button class="alert-close"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
        </div>
        <div class="fleet-alert alert-success">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <div class="alert-body"><div class="alert-title">Success!</div><div class="alert-text">Your changes have been saved successfully.</div></div>
        </div>
        <div class="fleet-alert alert-warning">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            <div class="alert-body"><div class="alert-title">Warning</div><div class="alert-text">Please review before submitting.</div></div>
        </div>
        <div class="fleet-alert alert-danger">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            <div class="alert-body"><div class="alert-title">Error</div><div class="alert-text">Something went wrong. Please try again.</div></div>
        </div>
    </div>
</div>

{# ================================================================
   FORMS
   ================================================================ #}
<div class="fleet-section-bar mb-5">
    <h2 class="fleet-section-title">Forms</h2>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Inputs</h3>
    </div>
    <div class="fleet-card-body">
        <div class="fleet-form-row cols-3 mb-4">
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Default Input</label>
                <input type="text" class="fleet-control" placeholder="Enter value...">
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Small Input</label>
                <input type="text" class="fleet-control control-sm" placeholder="Small...">
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Large Input</label>
                <input type="text" class="fleet-control control-lg" placeholder="Large...">
            </div>
        </div>
        <div class="fleet-form-row cols-3 mb-4">
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">With Icon Left</label>
                <div class="fleet-input-icon">
                    <input type="text" class="fleet-control" placeholder="Search...">
                    <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                </div>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">With Icon Right</label>
                <div class="fleet-input-icon">
                    <input type="email" class="fleet-control icon-right" placeholder="email@example.com">
                    <span class="input-icon icon-right"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
                </div>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Input Group</label>
                <div class="fleet-input-group">
                    <span class="fleet-input-addon">$</span>
                    <input type="number" class="fleet-control" placeholder="0.00">
                    <span class="fleet-input-addon">USD</span>
                </div>
            </div>
        </div>
        <div class="fleet-form-row cols-3">
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Valid State</label>
                <input type="text" class="fleet-control is-valid" value="Valid input">
                <div class="fleet-form-success">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    Looks good!
                </div>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Invalid State</label>
                <input type="text" class="fleet-control is-invalid" value="Bad input">
                <div class="fleet-form-error">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                    This field is required.
                </div>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">With Hint</label>
                <input type="text" class="fleet-control" placeholder="Enter reference...">
                <div class="fleet-form-hint">Must be 6–20 characters.</div>
            </div>
        </div>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Select · Textarea · Password</h3>
    </div>
    <div class="fleet-card-body">
        <div class="fleet-form-row cols-3 mb-4">
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Select <span class="required">*</span></label>
                <select class="fleet-select">
                    <option value="">Choose option...</option>
                    <option>Option 1</option>
                    <option>Option 2</option>
                    <option>Option 3</option>
                </select>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Select (small)</label>
                <select class="fleet-select control-sm">
                    <option>All Statuses</option>
                    <option>Active</option>
                    <option>Inactive</option>
                </select>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-label">Password</label>
                <div class="pw-wrapper">
                    <input type="password" class="fleet-control" placeholder="Enter password...">
                    <button type="button" class="pw-toggle">
                        <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="eye-off" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="fleet-form-group">
            <label class="fleet-label">Textarea</label>
            <textarea class="fleet-textarea" placeholder="Enter notes or description..."></textarea>
            <div class="fleet-form-hint">Max 500 characters.</div>
        </div>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Checkboxes · Radios · Toggle</h3>
    </div>
    <div class="fleet-card-body">
        <div class="fleet-form-row cols-3">
            <div>
                <div class="fleet-label mb-3">Checkboxes</div>
                <div class="fleet-checks-list">
                    <label class="fleet-check">
                        <input type="checkbox" checked>
                        <div class="check-body">
                            <span class="check-label">Monday</span>
                            <span class="check-hint">First workday</span>
                        </div>
                    </label>
                    <label class="fleet-check">
                        <input type="checkbox">
                        <div class="check-body"><span class="check-label">Tuesday</span></div>
                    </label>
                    <label class="fleet-check">
                        <input type="checkbox" disabled>
                        <div class="check-body"><span class="check-label">Disabled</span></div>
                    </label>
                </div>
            </div>
            <div>
                <div class="fleet-label mb-3">Radio Buttons</div>
                <div class="fleet-checks-list">
                    <label class="fleet-check">
                        <input type="radio" name="demo-radio" checked>
                        <div class="check-body"><span class="check-label">Option A</span></div>
                    </label>
                    <label class="fleet-check">
                        <input type="radio" name="demo-radio">
                        <div class="check-body"><span class="check-label">Option B</span></div>
                    </label>
                    <label class="fleet-check">
                        <input type="radio" name="demo-radio">
                        <div class="check-body"><span class="check-label">Option C</span></div>
                    </label>
                </div>
            </div>
            <div>
                <div class="fleet-label mb-3">Toggle Switches</div>
                <div class="d-flex flex-col gap-4">
                    <label class="fleet-toggle toggle-sm">
                        <input type="checkbox" checked>
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="toggle-label">Small</span>
                    </label>
                    <label class="fleet-toggle">
                        <input type="checkbox" checked>
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="toggle-label">Notifications on</span>
                    </label>
                    <label class="fleet-toggle toggle-lg">
                        <input type="checkbox">
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="toggle-label">Large toggle</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Search Input</h3>
    </div>
    <div class="fleet-card-body">
        <div class="fleet-filter-bar">
            <div class="fleet-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" placeholder="Search by name, ID, city...">
                <button class="search-clear">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
            </div>
            <select class="fleet-select control-sm w-auto">
                <option>All Statuses</option>
                <option>Active</option>
                <option>Inactive</option>
            </select>
            <select class="fleet-select control-sm w-auto">
                <option>All Types</option>
                <option>Type A</option>
                <option>Type B</option>
            </select>
            <button class="fleet-btn btn-outline-fleet btn-sm">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/></svg>
                Filters
            </button>
        </div>
    </div>
</div>

{# ================================================================
   TABLES
   ================================================================ #}
<div class="fleet-section-bar mb-5">
    <h2 class="fleet-section-title">Tables</h2>
</div>

<div class="fleet-card mb-5">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Standard Table</h3>
        <a href="#" class="view-all-link">View All →</a>
    </div>
    <div class="fleet-table-wrap">
        <table class="fleet-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Location</th>
                    <th>Progress</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><a class="fleet-link" href="#">#10042</a></td>
                    <td><strong>John Smith</strong></td>
                    <td><span class="fleet-badge badge-success">Active</span></td>
                    <td>Chicago, IL</td>
                    <td>
                        <div class="fleet-progress">
                            <div class="progress-track"><div class="progress-fill" style="width:72%"></div></div>
                            <span class="progress-pct">72%</span>
                        </div>
                    </td>
                    <td>
                        <div class="fleet-dropdown">
                            <button class="fleet-ctx-btn" data-dropdown-toggle="#ctx1">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                            </button>
                            <div class="fleet-dropdown-menu" id="ctx1">
                                <a href="#" class="fleet-dropdown-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>Edit</a>
                                <a href="#" class="fleet-dropdown-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>View Details</a>
                                <div class="fleet-dropdown-divider"></div>
                                <a href="#" class="fleet-dropdown-item danger" data-confirm="Delete this record?"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>Delete</a>
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><a class="fleet-link" href="#">#10043</a></td>
                    <td><strong>Maria Garcia</strong></td>
                    <td><span class="fleet-badge badge-warning">Pending</span></td>
                    <td>Dallas, TX</td>
                    <td>
                        <div class="fleet-progress">
                            <div class="progress-track"><div class="progress-fill fill-warning" style="width:35%"></div></div>
                            <span class="progress-pct">35%</span>
                        </div>
                    </td>
                    <td>
                        <div class="fleet-dropdown">
                            <button class="fleet-ctx-btn" data-dropdown-toggle="#ctx2">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                            </button>
                            <div class="fleet-dropdown-menu" id="ctx2">
                                <a href="#" class="fleet-dropdown-item"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/></svg>Edit</a>
                                <div class="fleet-dropdown-divider"></div>
                                <a href="#" class="fleet-dropdown-item danger"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12z"/></svg>Delete</a>
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
