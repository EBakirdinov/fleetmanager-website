</div>

{# Form modal #}
<div class="fleet-modal-backdrop" id="modal-form">
    <div class="fleet-modal">
        <div class="fleet-modal-header">
            <h4 class="fleet-modal-title">Add New Entry</h4>
            <button class="fleet-modal-close" data-modal-close>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
            </button>
        </div>
        <div class="fleet-modal-body">
            <div class="fleet-form-row mb-4">
                <div class="fleet-form-group no-mb">
                    <label class="fleet-label">First Name <span class="required">*</span></label>
                    <input type="text" class="fleet-control" placeholder="John">
                </div>
                <div class="fleet-form-group no-mb">
                    <label class="fleet-label">Last Name <span class="required">*</span></label>
                    <input type="text" class="fleet-control" placeholder="Smith">
                </div>
            </div>
            <div class="fleet-form-group">
                <label class="fleet-label">Email</label>
                <div class="fleet-input-icon">
                    <input type="email" class="fleet-control" placeholder="john@example.com">
                    <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
                </div>
            </div>
            <div class="fleet-form-group">
                <label class="fleet-label">Role</label>
                <select class="fleet-select">
                    <option value="">Select role...</option>
                    <option>Admin</option>
                    <option>Manager</option>
                    <option>Driver</option>
                </select>
            </div>
            <div class="fleet-form-group no-mb">
                <label class="fleet-toggle">
                    <input type="checkbox" checked>
                    <span class="toggle-track"><span class="toggle-thumb"></span></span>
                    <div>
                        <span class="toggle-label">Send welcome email</span>
                        <div class="toggle-hint">User will receive login instructions</div>
                    </div>
                </label>
            </div>
        </div>
        <div class="fleet-modal-footer">
            <button class="fleet-btn btn-outline-fleet" data-modal-close>Cancel</button>
            <button class="fleet-btn btn-primary-fleet">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                Save Entry
            </button>
        </div>
    </div>
</div>

