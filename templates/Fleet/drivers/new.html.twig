{% extends 'Fleet/base.html.twig' %}
{% block title %}Add Driver — FleetManager{% endblock %}
{% block breadcrumb %}
    <span class="bc-sep">›</span>
    <a href="{{ path('fleet_drivers') }}">Drivers</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Add Driver</span>
{% endblock %}

{% block content %}
<div class="page-head">
    <h1 class="page-heading">Add Driver</h1>
    <p class="page-sub">Fill in the details to create a new driver profile.</p>
</div>

<div class="fleet-card" style="max-width:780px;">
    <div class="fleet-card-header">
        <h3 class="fleet-card-title">Driver Information</h3>
    </div>
    <div class="fleet-card-body" style="padding:24px;">
        <form method="POST" action="{{ path('fleet_driver_new') }}">
            {% include 'Fleet/drivers/_form.html.twig' with {formData: formData, error: error} %}

            <div class="form-footer">
                <button type="submit" class="fleet-btn btn-primary-fleet">Create Driver</button>
                <a href="{{ path('fleet_drivers') }}" class="fleet-btn btn-outline-fleet">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
