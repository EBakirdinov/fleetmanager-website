{% extends 'Fleet/base.html.twig' %}
{% block title %}Drivers — FleetManager{% endblock %}
{% block breadcrumb %}<span class="bc-sep">›</span><span class="bc-current">Drivers</span>{% endblock %}

{% block content %}
<div class="page-head d-flex items-center justify-between flex-wrap gap-4">
    <div>
        <h1 class="page-heading">Drivers</h1>
        <p class="page-sub">Manage all drivers in your fleet.</p>
    </div>
    <a href="{{ path('fleet_driver_new') }}" class="fleet-btn btn-primary-fleet">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        Add Driver
    </a>
</div>

{# Stats #}
{% set total     = drivers|length %}
{% set active    = drivers|filter(d => d.status == 'active')|length %}
{% set offDuty   = drivers|filter(d => d.status == 'off_duty')|length %}
{% set suspended = drivers|filter(d => d.status == 'suspended')|length %}

<div class="fleet-stats-row cols-4" style="margin-bottom:18px;">
    <a href="{{ path('fleet_drivers') }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Total Drivers</div>
        <div class="fleet-stat-value">{{ total }}</div>
    </a>
    <a href="{{ path('fleet_drivers', {status:'active'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Active</div>
        <div class="fleet-stat-value text-success">{{ active }}</div>
    </a>
    <a href="{{ path('fleet_drivers', {status:'off_duty'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Off Duty</div>
        <div class="fleet-stat-value text-warning">{{ offDuty }}</div>
    </a>
    <a href="{{ path('fleet_drivers', {status:'suspended'}) }}" class="fleet-stat" style="text-decoration:none;cursor:pointer;">
        <div class="fleet-stat-label">Suspended</div>
        <div class="fleet-stat-value text-danger">{{ suspended }}</div>
    </a>
</div>

{# Active filter chip #}
{% if statusFilter %}
<div class="d-flex items-center gap-3" style="margin-bottom:14px;">
    <span class="text-sm text-sub">Filtered by status:</span>
    <span class="fleet-badge {% if statusFilter == 'active' %}badge-success{% elseif statusFilter == 'off_duty' %}badge-warning{% else %}badge-danger{% endif %}">
        {{ statusFilter|replace({'_':' '})|title }}
    </span>
    <a href="{{ path('fleet_drivers') }}" class="text-sm text-sub" style="text-decoration:none;">✕ Clear</a>
</div>
{% endif %}

<div class="fleet-card">
    {% if drivers|length == 0 %}
        <div class="fleet-empty">
            <div class="fleet-empty-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            <div class="fleet-empty-title">No drivers found</div>
            <div class="fleet-empty-text">
                {% if statusFilter %}No drivers with that status.{% else %}Add your first driver to get started.{% endif %}
            </div>
            <a href="{{ path('fleet_driver_new') }}" class="fleet-btn btn-primary-fleet">Add Driver</a>
        </div>
    {% else %}
        <div class="fleet-table-wrap">
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>License #</th>
                        <th>License Expiry</th>
                        <th>Assigned Truck</th>
                        <th style="width:90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for driver in drivers %}
                    <tr>
                        <td>
                            <a href="{{ path('fleet_driver_edit', {id: driver.id}) }}" class="fleet-link fw-600">
                                {{ driver.first_name ?? '' }} {{ driver.last_name ?? '' }}
                            </a>
                        </td>
                        <td>
                            {% if driver.status == 'active' %}
                                <span class="fleet-badge badge-success">Active</span>
                            {% elseif driver.status == 'off_duty' %}
                                <span class="fleet-badge badge-warning">Off Duty</span>
                            {% elseif driver.status == 'suspended' %}
                                <span class="fleet-badge badge-danger">Suspended</span>
                            {% else %}
                                <span class="fleet-badge badge-gray">{{ driver.status ?? '—' }}</span>
                            {% endif %}
                        </td>
                        <td>{{ driver.phone ?? '—' }}</td>
                        <td>{{ driver.email ?? '—' }}</td>
                        <td>{{ driver.license_number ?? '—' }}</td>
                        <td>
                            {% if driver.license_expiration %}
                                {{ driver.license_expiration|date('M d, Y') }}
                            {% else %}—{% endif %}
                        </td>
                        <td>
                            {% if driver.assigned_truck is defined and driver.assigned_truck %}
                                <span class="fleet-badge badge-gray">
                                    {{ driver.assigned_truck.truck_number ?? ('#' ~ driver.assigned_truck.id) }}
                                </span>
                            {% else %}
                                <span class="text-muted">Unassigned</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-1 items-center">
                                <a href="{{ path('fleet_driver_edit', {id: driver.id}) }}"
                                   class="fleet-btn btn-ghost-fleet btn-xs" title="Edit">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                    </svg>
                                </a>
                                <button class="fleet-btn btn-ghost-danger btn-xs js-delete-driver"
                                        data-id="{{ driver.id }}"
                                        data-name="{{ ((driver.first_name ?? '') ~ ' ' ~ (driver.last_name ?? ''))|trim }}"
                                        title="Delete">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Delete confirmation modal #}
<div class="fleet-modal-backdrop" id="deleteModal">
    <div class="fleet-modal modal-sm">
        <div class="fleet-modal-header">
            <h3 class="fleet-modal-title">Delete Driver</h3>
            <button class="fleet-modal-close" id="deleteModalClose" type="button">&times;</button>
        </div>
        <div class="fleet-modal-body">
            <p class="m-0">Are you sure you want to delete <strong id="deleteDriverName"></strong>? This cannot be undone.</p>
        </div>
        <div class="fleet-modal-footer">
            <button class="fleet-btn btn-outline-fleet" id="deleteModalCancel" type="button">Cancel</button>
            <form id="deleteForm" method="POST" style="margin:0;">
                <button type="submit" class="fleet-btn btn-danger-fleet">Delete</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var modal     = document.getElementById('deleteModal');
    var nameEl    = document.getElementById('deleteDriverName');
    var form      = document.getElementById('deleteForm');
    var btnClose  = document.getElementById('deleteModalClose');
    var btnCancel = document.getElementById('deleteModalCancel');

    document.querySelectorAll('.js-delete-driver').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id   = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name') || 'this driver';
            nameEl.textContent = name;
            form.setAttribute('action', '/drivers/' + id + '/delete');
            modal.classList.add('show');
        });
    });

    function closeModal() { modal.classList.remove('show'); }
    btnClose.addEventListener('click', closeModal);
    btnCancel.addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
}());
</script>
{% endblock %}
